<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexTokenOverlay</AssemblyName>
    <RootNamespace>CodexTokenOverlay</RootNamespace>
    <Version>0.1.1</Version>
    <FileVersion>0.1.1.0</FileVersion>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <Description>Cross-platform external token overlay for Codex sessions.</Description>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CodexTokenOverlay\CodexVersionDetector.cs" Link="Shared\CodexVersionDetector.cs" />
    <Compile Include="..\CodexTokenOverlay\ModelContextWindowResolver.cs" Link="Shared\ModelContextWindowResolver.cs" />
    <Compile Include="..\CodexTokenOverlay\OverlayDiagnostics.cs" Link="Shared\OverlayDiagnostics.cs" />
    <Compile Include="..\CodexTokenOverlay\SessionPathResolver.cs" Link="Shared\SessionPathResolver.cs" />
    <Compile Include="..\CodexTokenOverlay\TokenLogMonitor.cs" Link="Shared\TokenLogMonitor.cs" />
    <Compile Include="..\CodexTokenOverlay\TokenSnapshot.cs" Link="Shared\TokenSnapshot.cs" />
  </ItemGroup>
</Project>
